rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users
// Document ID: the player's Firebase Auth uid
// Fields (all required, no other fields allowed):
//   - v: int (required, == 1) - save format version
//   - coins: int (required, 0..10,000,000 and <= 125 * stats.runs) - 금화
//   - items: map (required) - consumables, every count an int 0..9
//       - key (여분의 열쇠) and lens (통찰의 렌즈): required
//       - shield (보호의 인장), revive (불사조 깃털), candle (지혜의 촛대): optional
//         (saves from before these items existed have only key and lens)
//   - skins: list<string> (required, 1..5 unique items from
//       ['emerald', 'sapphire', 'garnet', 'obsidian', 'amber'], always contains 'emerald') - owned themes
//   - skin: string (required, one of skins) - equipped theme
//   - stats: map (required, exactly { runs, clears, perfect, rooms }) - ints,
//       0 <= perfect <= clears <= runs <= 10,000,000 and rooms <= 5 * runs; never decrease
//   - updatedAt: timestamp (required, == request.time; the client writes serverTimestamp())
//   - rev: int (optional, 0..1,000,000) - how many times admins changed this record (운영자 화면).
//       The owner's saves must keep it, so a device holding an older copy is refused, reloads the record
//       and adds only its own new progress on top. Each admin change raises it by exactly 1.
//   - gift: int (optional, 0..10,000,000) - coins admins have given (운영자 화면 → 금화 주기). Only admins change it.
//   - got: int (optional, 0..10,000,000) - coins taken in from friends' gifts; never more than giftbox/<uid>.total.
//       Only goes up, and a save that raises it may add that many coins on top of what the progress pays.
//   - friendsOff: bool (optional) - the player turned the friend feature off (it is on by default)
//   coins <= 125 * stats.runs + gift + got
//
// Collection: feedback ('의견 보내기')
// Document ID: '<uid>_<n>', where n is the sender's feedbackMeta count after this message
// Fields the sender writes (all required, no other fields allowed; the sender only creates):
//   - uid: string (== request.auth.uid) - sender
//   - category: string, one of ['bug', 'problem', 'idea', 'delete', 'etc']
//   - text: string (5..1000 chars)
//   - version: string (<= 20 chars) - game version
//   - device: string (<= 300 chars) - browser/OS and screen size
//   - createdAt: timestamp (== request.time)
// Fields only admins add (운영자 화면 → 문의):
//   - status: 'new' | 'doing' | 'done' (absent = 'new')
//   - reply: string (0..1000 chars) - the answer the sender sees
//   - repliedAt: timestamp (== request.time whenever reply changes)
//   - handledAt: timestamp (== request.time on every admin change)
// The sender and admins can read a message; only admins change or delete it.
//
// Collection: feedbackMeta (one per sender, written in the same transaction as each feedback message)
// Document ID: the sender's uid
// Fields (all required, no other fields allowed):
//   - count: int - how many messages this player has sent (goes up by exactly 1 per message)
//   - last: timestamp (== request.time) - when the last message was sent; the next one must be >= 60 s later
//
// Collection: players ('친구' public profile, only for players who turned the friend feature on)
// Document ID: the player's uid
// Fields (all required, no other fields allowed):
//   - code: string - friend code, 6 chars from [A-HJ-NP-Z2-9]; never changes
//   - name: string - name the player chose, 2..12 chars of Korean/Latin letters, digits, space . _ - (no leading/trailing space)
//   - skin: string (== users/<uid>.skin) - equipped theme
//   - stats: map (== users/<uid>.stats) - so friends see the same checked progress
//   - updatedAt: timestamp (== request.time)
// Any signed-in player can get one by uid (friends' list, requests); nobody can list the collection.
//
// Collection: codes (friend code → uid)
// Document ID: the code
// Fields: uid (string, == creator) only. Created in the same batch as the players document that holds the code.
// Any signed-in player can get one (to find a friend by code); nobody can list or change them.
//
// Collection: friendships
// Document ID: '<smaller uid>_<larger uid>'
// Fields:
//   - users: list<string> - exactly [smaller uid, larger uid]
//   - from: string - who sent the request (one of users)
//   - status: 'pending' | 'accepted'
//   - createdAt: timestamp (== request.time at creation)
//   - acceptedAt: timestamp - only when accepted (== request.time)
// The sender creates it as pending (both players must have a players document); only the other player can accept;
// either player can delete it (decline, cancel, unfriend). Players list their own with where('users', 'array-contains', uid).
//
// Collection: bans ('이용 제한', written only by admins)
// Document ID: the restricted player's uid
// Fields (all required, no other fields allowed):
//   - reason: string (1..200 chars) - shown to the player
//   - at: timestamp (== request.time)
// A restricted player cannot send feedback, turn the friend feature on, update a public profile, or send or accept
// friend requests. They can still play, save their record, read their own restriction and delete their own friend data.
//
// 금화 선물 (friends send each other coins; admins have no limits and pay nothing):
// Collection: giftbox (one per receiver)
// Document ID: the receiver's uid
// Fields: total: int - every coin friends have sent this player (only goes up; the receiver takes them in by raising users.got)
// Only friends write it (FieldValue.increment), in one transaction that also lowers the sender's users.coins by exactly
// the amount (nothing else may change in that save), raises giftMeta/<sender> and adds a gifts log entry.
// A gift is 10..100 coins and a sender sends at most 300 coins per day (Korean time). The receiver and admins read it.
//
// Collection: giftMeta (one per sender)
// Document ID: the sender's uid
// Fields: day: int (days since 1970-01-01 in Korean time, == today), total: int (coins sent today, 10..300; only goes up within a day)
//
// Collection: gifts (log shown to the receiver)
// Document ID: auto id
// Fields: from (== sender uid), to (receiver uid), amount (int), at (timestamp == request.time).
// Created only together with a giftbox raise of the same amount. The receiver and the sender read it; the receiver deletes it.
//
// Admins (운영자 화면) can read every document above, change feedback status and replies, change users records
// (raising rev), delete public profiles, friend codes, friendships, feedback and feedbackMeta, and write bans.
//
// No email or Google profile is stored anywhere. users documents are read by their owner and admins,
// and written by their owner (fair saves) or by admins.
//
// Anti-cheat (the game runs in the browser, so the server checks every save against the previous one):
//   - Coins can only go up by what the new progress can pay out: 15 per new room (10 correct + 5 first try),
//     30 per new clear and 20 per new perfect clear.
//   - Every item or theme that appears in a save must be paid for with coins in that same save,
//     at the shop prices below. Only admins (checked here from the signed-in Google email) get the shop for free.
//   - New clears, perfect clears and rooms must come with new runs (at most 5 rooms per run).
//   - A new account (the guest record moved on first sign-in) cannot hold more coins, items and themes
//     than its runs could have paid for.
//   Records that stay within these limits can still be made up in the browser; stopping that would need a game server.
//
// IMPORTANT: if the game's rewards, shop prices, item limits, theme ids or admins change, update this file too.
//   index.html: REWARD, WARES, SKINS, ADMIN_HASHES
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the signed-in user owns the document (document id == uid)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Integer within an inclusive range
    function isIntInRange(value, minValue, maxValue) {
      return value is int && value >= minValue && value <= maxValue;
    }

    // Map that has exactly the given keys (no missing, no extra)
    function hasExactKeys(data, keys) {
      return data is map && data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    // Admins (운영진): a Google-verified email whose SHA-256('logicmaze:' + lowercased email) is in the list.
    // Same list as ADMIN_HASHES in index.html, so no plain email is in the public repository.
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && hashing.sha256('logicmaze:' + request.auth.token.email.lower()).toHexString().lower() in [
          'd8700fe4292519649687c4ae9036295332c4fc001e980743556a77e56caf23eb',
          'c56fd8778bd83c4b806cbe51b9f3d9d0e458ca85ba944d0dc9df77fa54c078d2',
          '5b21363f857ade65a51184dc9e6e6d687066cdb6e9f96c2adf2c3b85fbceeda8',
          'c2126cd1388f157c732a458ffcd78813a7098394a6ae6887e77c1c4bbcbd2337'
        ];
    }

    // ===============================================================
    // Domain Validators (used by both create and update)
    // ===============================================================

    // Optional count: absent, or an int 0..9
    function isOptionalCount(items, name) {
      return !(name in items) || isIntInRange(items[name], 0, 9);
    }

    function isValidItems(items) {
      return items is map
        && items.keys().hasAll(['key', 'lens'])
        && items.keys().hasOnly(['key', 'lens', 'shield', 'revive', 'candle'])
        && isIntInRange(items.key, 0, 9)
        && isIntInRange(items.lens, 0, 9)
        && isOptionalCount(items, 'shield')
        && isOptionalCount(items, 'revive')
        && isOptionalCount(items, 'candle');
    }

    function isValidStats(stats) {
      return hasExactKeys(stats, ['runs', 'clears', 'perfect', 'rooms'])
        && isIntInRange(stats.runs, 0, 10000000)
        && isIntInRange(stats.clears, 0, stats.runs)
        && isIntInRange(stats.perfect, 0, stats.clears)
        && isIntInRange(stats.rooms, 0, stats.runs * 5);
    }

    function isValidSkins(data) {
      return data.skins is list
        && data.skins.size() >= 1
        && data.skins.size() <= 5
        && data.skins.toSet().size() == data.skins.size()
        && data.skins.hasOnly(['emerald', 'sapphire', 'garnet', 'obsidian', 'amber'])
        && 'emerald' in data.skins
        && data.skin is string
        && data.skin in data.skins;
    }

    function isValidProfile(data) {
      return data is map
        && data.keys().hasAll(['v', 'coins', 'items', 'skins', 'skin', 'stats', 'updatedAt'])
        && data.keys().hasOnly(['v', 'coins', 'items', 'skins', 'skin', 'stats', 'updatedAt', 'rev', 'gift', 'got', 'friendsOff'])
        && (!('rev' in data) || isIntInRange(data.rev, 0, 1000000))
        && (!('gift' in data) || isIntInRange(data.gift, 0, 10000000))
        && (!('got' in data) || isIntInRange(data.got, 0, 10000000))
        && (!('friendsOff' in data) || data.friendsOff is bool)
        && data.v is int && data.v == 1
        && isValidItems(data.items)
        && isValidStats(data.stats)
        && isIntInRange(data.coins, 0, 10000000)
        && data.coins <= data.stats.runs * 125 + data.get('gift', 0) + data.get('got', 0)
        && isValidSkins(data)
        && data.updatedAt == request.time;
    }

    // ===============================================================
    // Anti-cheat: coins must match progress and purchases
    // ===============================================================

    // How many more of an item there are after the save (0 if it went down or stayed)
    function gainedOf(after, before, name) {
      let d = after.get(name, 0) - before.get(name, 0);
      return d > 0 ? d : 0;
    }

    // Coins the new items cost (shop prices: index.html WARES)
    function itemCost(after, before) {
      return gainedOf(after, before, 'key') * 80
        + gainedOf(after, before, 'lens') * 50
        + gainedOf(after, before, 'shield') * 70
        + gainedOf(after, before, 'revive') * 120
        + gainedOf(after, before, 'candle') * 40;
    }

    function skinPrice(after, before, id, price) {
      return (id in after && !(id in before)) ? price : 0;
    }

    // Coins the new themes cost (shop prices: index.html SKINS; emerald is free)
    function skinCost(after, before) {
      return skinPrice(after, before, 'sapphire', 300)
        + skinPrice(after, before, 'garnet', 300)
        + skinPrice(after, before, 'obsidian', 400)
        + skinPrice(after, before, 'amber', 400);
    }

    // Most coins a record can have earned (index.html REWARD): 15 per room, 30 per clear, 20 per perfect clear
    function maxEarned(stats) {
      return stats.rooms * 15 + stats.clears * 30 + stats.perfect * 20;
    }

    // New progress only goes up, and every new clear, perfect clear and room comes with a new run
    function isNewProgress(after, before) {
      let runs = after.runs - before.runs;
      let clears = after.clears - before.clears;
      let perfect = after.perfect - before.perfect;
      let rooms = after.rooms - before.rooms;
      return runs >= 0
        && clears >= 0 && clears <= runs
        && perfect >= 0 && perfect <= clears
        && rooms >= 0 && rooms <= runs * 5;
    }

    // An update: coins go up by at most what the new progress pays, minus the price of new items and themes,
    // plus friends' gifts taken in (got goes up, never past giftbox/<uid>.total). Only admins change gift.
    function isFairUpdate(after, before) {
      let cost = isAdmin() ? 0 : itemCost(after.items, before.items) + skinCost(after.skins, before.skins);
      let got = after.get('got', 0) - before.get('got', 0);
      return isNewProgress(after.stats, before.stats)
        && after.get('gift', 0) == before.get('gift', 0)
        && got >= 0
        && (got == 0 || after.got <= get(giftboxPath(request.auth.uid)).data.total)
        && after.coins - before.coins <= maxEarned(after.stats) - maxEarned(before.stats) - cost + got;
    }

    // A new account: coins plus the price of every item and theme it holds fit in what its runs could earn
    function isFairStart(data) {
      return isAdmin()
        || data.coins + itemCost(data.items, {}) + skinCost(data.skins, ['emerald']) <= maxEarned(data.stats);
    }

    function isValidFeedback(data) {
      return hasExactKeys(data, ['uid', 'category', 'text', 'version', 'device', 'createdAt'])
        && data.uid == request.auth.uid
        && data.category in ['bug', 'problem', 'idea', 'delete', 'etc']
        && data.text is string && data.text.size() >= 5 && data.text.size() <= 1000
        && data.version is string && data.version.size() <= 20
        && data.device is string && data.device.size() <= 300
        && data.createdAt == request.time;
    }

    function isValidFeedbackMeta(data) {
      return hasExactKeys(data, ['count', 'last'])
        && data.count is int
        && data.last == request.time;
    }

    function feedbackMetaPath(userId) {
      return /databases/$(database)/documents/feedbackMeta/$(userId);
    }

    // ===============================================================
    // Admin tools (운영자 화면)
    // ===============================================================

    // Admin changes: rev (absent = 0)
    function revOf(data) {
      return data.get('rev', 0);
    }

    // An admin handles a message: only status, reply, repliedAt and handledAt change.
    // A new or changed reply always comes with repliedAt == now (and repliedAt never moves on its own).
    function isValidHandling(after, before) {
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['status', 'reply', 'repliedAt', 'handledAt'])
        && after.status in ['new', 'doing', 'done']
        && after.handledAt == request.time
        && (!('reply' in after) || (after.reply is string && after.reply.size() <= 1000))
        && (!changed.hasAny(['reply', 'repliedAt'])
          || (changed.hasAll(['reply', 'repliedAt']) && 'reply' in after && after.repliedAt == request.time));
    }

    function isValidBan(data) {
      return hasExactKeys(data, ['reason', 'at'])
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 200
        && data.at == request.time;
    }

    // The signed-in player is restricted (이용 제한)
    function isBanned() {
      return exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    // ===============================================================
    // 금화 선물 (friends' gifts)
    // ===============================================================

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function giftboxPath(userId) {
      return /databases/$(database)/documents/giftbox/$(userId);
    }

    function giftMetaPath(userId) {
      return /databases/$(database)/documents/giftMeta/$(userId);
    }

    function friendshipPath(a, b) {
      return /databases/$(database)/documents/friendships/$(a < b ? a + '_' + b : b + '_' + a);
    }

    // Today in Korean time (UTC+9), as days since 1970-01-01
    function giftDay() {
      return math.floor((request.time.toMillis() + 32400000) / 86400000);
    }

    // Coins the sender had sent today before this write
    function sentToday(userId) {
      return exists(giftMetaPath(userId)) && get(giftMetaPath(userId)).data.day == giftDay()
        ? get(giftMetaPath(userId)).data.total : 0;
    }

    // How much this request raises giftbox/<to> (state after the whole write minus the stored state),
    // so writing the same giftbox twice in one batch counts as one bigger gift
    function boxRaise(to) {
      return getAfter(giftboxPath(to)).data.total
        - (exists(giftboxPath(to)) ? get(giftboxPath(to)).data.total : 0);
    }

    // The signed-in player sends boxRaise(to) coins to `to`. Admins send any amount and pay nothing.
    function isGiftTransfer(to) {
      return request.auth.uid != to
        && (isAdmin() ? boxRaise(to) >= 1 && boxRaise(to) <= 1000000 : isFriendGift(to, boxRaise(to)));
    }

    // A friend's gift: 10..100 coins, at most 300 a day, to an accepted friend. The same write lowers the sender's
    // coins by exactly the amount with no new progress, items or themes (so the gift cannot pay for anything else),
    // and raises giftMeta/<sender> by the amount, naming this receiver (so one write carries one gift).
    function isFriendGift(to, amount) {
      let me = request.auth.uid;
      let before = get(userPath(me)).data;
      let after = getAfter(userPath(me)).data;
      let meta = getAfter(giftMetaPath(me)).data;
      return !isBanned()
        && amount >= 10 && amount <= 100
        && after.coins == before.coins - amount
        && after.stats == before.stats
        && itemCost(after.items, before.items) == 0
        && skinCost(after.skins, before.skins) == 0
        && exists(friendshipPath(me, to))
        && get(friendshipPath(me, to)).data.status == 'accepted'
        && meta.to == to
        && meta.amount == amount
        && meta.total == sentToday(me) + amount;
    }

    // giftMeta: today's total only goes up, by this gift's amount (a new day starts again from the amount)
    function isValidGiftMeta(data, sentBefore) {
      return hasExactKeys(data, ['day', 'total', 'to', 'amount'])
        && data.day == giftDay()
        && data.to is string && data.to != request.auth.uid
        && isIntInRange(data.amount, 10, 100)
        && data.total == sentBefore + data.amount
        && data.total <= 300;
    }

    // ===============================================================
    // Friends (친구)
    // ===============================================================

    function playerPath(userId) {
      return /databases/$(database)/documents/players/$(userId);
    }

    function codePath(code) {
      return /databases/$(database)/documents/codes/$(code);
    }

    // Public profile: skin and stats must match the checked users document, so friends see real progress
    function isValidPlayer(userId, data) {
      let user = get(/databases/$(database)/documents/users/$(userId)).data;
      return hasExactKeys(data, ['code', 'name', 'skin', 'stats', 'updatedAt'])
        && data.code is string && data.code.matches('[A-HJ-NP-Z2-9]{6}')
        && data.name is string
        && data.name.matches('[가-힣ㄱ-ㅣA-Za-z0-9._-][가-힣ㄱ-ㅣA-Za-z0-9 ._-]{0,10}[가-힣ㄱ-ㅣA-Za-z0-9._-]')
        && data.skin == user.skin
        && data.stats == user.stats
        && data.updatedAt == request.time;
    }

    function isValidFriendRequest(pairId, data) {
      return hasExactKeys(data, ['users', 'from', 'status', 'createdAt'])
        && data.users is list && data.users.size() == 2
        && data.users[0] is string && data.users[1] is string
        && data.users[0] < data.users[1]
        && pairId == data.users[0] + '_' + data.users[1]
        && data.from == request.auth.uid
        && request.auth.uid in data.users
        && data.status == 'pending'
        && data.createdAt == request.time
        && exists(playerPath(data.users[0]))
        && exists(playerPath(data.users[1]));
    }

    // ===============================================================
    // Rules (everything not matched below is denied)
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && isValidProfile(request.resource.data)
        && request.resource.data.get('gift', 0) == 0
        && request.resource.data.get('got', 0) == 0
        && isFairStart(request.resource.data);
      // The owner saves fair progress and keeps rev; an admin may set any valid record, raising rev by 1
      allow update: if isValidProfile(request.resource.data)
        && ((isOwner(userId)
            && revOf(request.resource.data) == revOf(resource.data)
            && isFairUpdate(request.resource.data, resource.data))
          || (isAdmin() && revOf(request.resource.data) == revOf(resource.data) + 1));
      allow delete: if false;
    }

    // 의견 보내기: signed-in players add their own messages, one per minute.
    // Each message is '<uid>_<n>' and must be written together with feedbackMeta/<uid> moving to count n,
    // so one transaction can add only one message. The sender reads their own messages (and the replies);
    // admins read, handle and delete them.
    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated()
        && !isBanned()
        && isValidFeedback(request.resource.data)
        && getAfter(feedbackMetaPath(request.auth.uid)).data.last == request.time
        && feedbackId == request.auth.uid + '_' + string(getAfter(feedbackMetaPath(request.auth.uid)).data.count);
      allow update: if isAdmin() && isValidHandling(request.resource.data, resource.data);
      allow delete: if isAdmin();
    }

    match /feedbackMeta/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && isValidFeedbackMeta(request.resource.data)
        && request.resource.data.count == 1
        && existsAfter(/databases/$(database)/documents/feedback/$(userId + '_1'));
      allow update: if isOwner(userId)
        && isValidFeedbackMeta(request.resource.data)
        && request.resource.data.count == resource.data.count + 1
        && request.time >= resource.data.last + duration.value(60, 's')
        && existsAfter(/databases/$(database)/documents/feedback/$(userId + '_' + string(request.resource.data.count)));
      allow delete: if isAdmin();
    }

    // 친구: public profile. Created together with its friend code; the code never changes.
    // Admins can list them (search by name) and delete them (with the code and friendships).
    match /players/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && !isBanned()
        && isValidPlayer(userId, request.resource.data)
        && getAfter(codePath(request.resource.data.code)).data.uid == userId;
      allow update: if isOwner(userId)
        && !isBanned()
        && isValidPlayer(userId, request.resource.data)
        && request.resource.data.code == resource.data.code;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Friend code → uid. An existing code cannot be overwritten (that is an update), so a clash makes the batch fail.
    match /codes/{code} {
      allow get: if isAuthenticated();
      allow list, update: if false;
      allow create: if isAuthenticated()
        && !isBanned()
        && hasExactKeys(request.resource.data, ['uid'])
        && request.resource.data.uid == request.auth.uid
        && code.matches('[A-HJ-NP-Z2-9]{6}')
        && getAfter(playerPath(request.auth.uid)).data.code == code;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    match /friendships/{pairId} {
      // A single document (even a missing one) can be read by either player in the pair id
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid in pairId.split('_'));
      allow list: if isAdmin() || (isAuthenticated() && request.auth.uid in resource.data.users);
      allow create: if isAuthenticated() && !isBanned() && isValidFriendRequest(pairId, request.resource.data);
      // Only the player who received the request accepts it, and only status and acceptedAt change
      allow update: if isAuthenticated()
        && !isBanned()
        && resource.data.status == 'pending'
        && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.from
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time;
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid in resource.data.users);
    }

    // 이용 제한: the player reads their own; admins write them
    match /bans/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() && isValidBan(request.resource.data);
    }

    // 금화 선물: what friends sent this player in total. Senders raise it; the receiver only reads it.
    match /giftbox/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create, update: if isAuthenticated()
        && hasExactKeys(request.resource.data, ['total'])
        && request.resource.data.total is int
        && isGiftTransfer(userId);
      allow delete: if false;
    }

    match /giftMeta/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && isValidGiftMeta(request.resource.data, 0);
      allow update: if isOwner(userId)
        && isValidGiftMeta(request.resource.data, resource.data.day == giftDay() ? resource.data.total : 0);
      allow delete: if false;
    }

    // Gift log: written with the gift it describes; the receiver lists (where to == uid) and deletes it
    match /gifts/{giftId} {
      allow read: if isAdmin()
        || (isAuthenticated() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid));
      allow create: if isAuthenticated()
        && hasExactKeys(request.resource.data, ['from', 'to', 'amount', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.amount is int
        && request.resource.data.at == request.time
        && boxRaise(request.resource.data.to) == request.resource.data.amount
        && isGiftTransfer(request.resource.data.to);
      allow update: if false;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.to == request.auth.uid);
    }
  }
}
